{
  "name": "ethioshield",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Experimental EthioShield application security SDK and platform foundation.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -b",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:integration && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "express": "5.1.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vitest": "3.2.4"
  }
}
